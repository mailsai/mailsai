# A test key is enough to see the whole thing work — nothing is transmitted.
# Get one: mails.ai → API Keys → New key → mode: test
MAILS_API_KEY=mk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. The agent's name; it gets <name>@<your-workspace>.mails.ai on first send.
MAILS_AGENT=support

# Optional. true = watch a REAL inbox instead of the three simulated emails.
# With a live key this replies to real people, so read agent.mjs first.
MAILS_LIVE=false
